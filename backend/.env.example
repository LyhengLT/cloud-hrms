# Backend-only env (for running uvicorn locally without Docker).
DATABASE_URL=postgresql+psycopg2://hrms:hrms_pass@localhost:5432/hrms
JWT_SECRET=please-change-this-to-a-long-random-string
SEED_ON_START=true

# Password reset
FRONTEND_URL=http://localhost:5173

# SMTP — for the forgot-password email. Gmail example below.
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password (Google Account > Security > App passwords)
# 3) Put the 16-char app password in SMTP_PASSWORD (no spaces)
# If these are left blank, the reset link is printed to the backend logs instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Cloud HRMS <youraddress@gmail.com>
