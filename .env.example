# Copy to .env and adjust. docker-compose reads this automatically.
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_pass
POSTGRES_DB=hrms
JWT_SECRET=please-change-this-to-a-long-random-string

# Where the app is reached (used to build the password-reset link in emails)
FRONTEND_URL=http://localhost:5173

# SMTP for the forgot-password email (Gmail shown).
# Leave SMTP_HOST blank to skip email and print the reset link to backend logs.
# Gmail needs an APP PASSWORD (2-Step Verification on -> Security -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Cloud HRMS <youraddress@gmail.com>
